#
# Dell Precision Tower 5810 hardware (serial J35FZG2):
# - CPU: Xeon E5-1650 v3 (Haswell-EP, 3.5 GHz)
# - GPU: NVIDIA RTX 3060 12GB (Turing, sm_75) — PCIe 3.0 x16, Slot 1 (only GPU)
#   - the former NVIDIA GT 730 (Kepler) in Slot 3 was removed
# - RAM: DDR4 ECC Registered (Xeon platform)
# - Storage: [TODO: fill in disk UUIDs from nixos-generate-config]
# - Network: [TODO: fill in network interface from nixos-generate-config]
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [
      (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot = {
    blacklistedKernelModules = lib.optionals (!config.hardware.enableRedistributableFirmware) [
      "ath3k"
    ];
    initrd = {
      availableKernelModules = [
        "ahci"
        "sd_mod"
        "usb_storage"
        "usbhid"
        "aesni_intel" # LUKS decryption in initrd
        "cryptd"      # LUKS decryption in initrd
      ];
      kernelModules = [
        "nvidia"
        "nvidia_modeset"
        "nvidia_drm"
        "nvidia_uvm"
      ];
      # Second SATA SSD (2 TB) — LUKS-encrypted, holds Syncthing data.
      # TODO: Fill in the LUKS UUIDs after running `nixos-generate-config` on
      # the machine and decrypting the drive:
      #   cryptsetup luksFormat /dev/sdX1
      #   cryptsetup open --type luks /dev/sdX1 data
      #   mkfs.btrfs -L data /dev/mapper/data
      luks = {
        devices = {
          # TODO: replace with actual LUKS UUID from nixos-generate-config
          "luks-DATA-UUID".device = "/dev/disk/by-uuid/TODO_LUKS_UUID"; # data
        };
      };
    };
    kernelModules = [ ];
    # kernel.sysctl = { };
  };

  fileSystems = {
    # TODO: Replace with actual disk UUID from nixos-generate-config
    "/" = {
      device = "/dev/disk/by-uuid/TODO_REPLACE";
      fsType = "ext4";
      options = [ "noatime" ];
    };
    "/boot" = {
      device = "/dev/disk/by-uuid/TODO_REPLACE";
      fsType = "vfat";
    };
    # Second SATA SSD (2 TB), LUKS+btrfs — carries the Syncthing data tree.
    # Mounted at /data so the bind mount below can serve it at /sync.
    "/data" = {
      device = "/dev/mapper/luks-DATA-UUID";
      fsType = "btrfs";
      options = [ "compress=zstd" "noatime" ];
    };
  };

  swapDevices = [ ];

  networking.useDHCP = lib.mkDefault true;
  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  hardware = {
    cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
    graphics = {
      enable = true;
      enable32Bit = true;
    };
    nvidia = {
      # NVIDIA RTX 3060 12GB (Turing, compute capability 7.5)
      dynamicBoost.enable = false;
      gsp.enable = true;
      modesetting.enable = true;
      nvidiaSettings = true;
      open = false;
      package = config.boot.kernelPackages.nvidiaPackages.stable;
      powerManagement = {
        enable = false;
        finegrained = false;
      };
      prime = {
        # Single-GPU system: the RTX 3060 (Slot 1) is the only and display GPU.
        # The former GT 730 (Slot 3) was removed, so there is no dual-GPU offload.
        nvidiaBusId = "PCI:1:0:0"; # TODO: verify with `lspci | grep -i nvidia`
      };
      videoAcceleration = true;
    };
  };
}
