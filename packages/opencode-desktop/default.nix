# opencode Desktop — the Electron GUI of the opencode v2 line
# (https://opencode.ai/v2/docs, "Desktop"): a graphical front end to the same
# agent as packages/opencode2's CLI. Upstream publishes it only as prebuilt
# per-platform installers (AppImage / .deb / .rpm) under
# https://opencode.ai/files/bin/<version>/, so there is no source build here.
#
# Like packages/orca and packages/browseros, wrap the released AppImage with
# appimageTools.wrapType2: a hash-pinned, immutable derivation that never
# writes to the store and cannot self-update (upstream's Electron auto-updater
# would download and run an unpatched binary).
#
# The bundle is self-contained: it carries its own Electron runtime AND its own
# agent server at resources/opencode-cli, so it does not depend on — and cannot
# drift from — the `opencode` CLI installed by packages/opencode2. Both read
# the same ~/.config/opencode config and models.
#
# Update: ./update.py regenerates the block below from
# https://opencode.ai/update/api/latest/desktop (which also publishes the
# per-platform sha256, so no prefetching); `nix-update opencode-desktop --flake
# --use-update-script` runs it.
{
  lib,
  stdenv,
  appimageTools,
  fetchurl,
  runtimeShell,
  ...
}:

let
  pname = "opencode-desktop";

  # >>> generated by update.py
  version = "2.0.30";

  perArch = {
    x86_64-linux = {
      url = "https://opencode.ai/files/bin/${version}/opencode-desktop-linux-x86_64.AppImage";
      hash = "sha256-Rc8avxl4lckb0t9aRli64YzXAMzyDyxEW97mB+g7uCI=";
    };
    aarch64-linux = {
      url = "https://opencode.ai/files/bin/${version}/opencode-desktop-linux-arm64.AppImage";
      hash = "sha256-eDkWfCvpOgTDjqA5CiR5EUdFXRmlss3TMc5VzF+278A=";
    };
  };
  # <<< generated by update.py

  src = fetchurl (
    perArch.${stdenv.hostPlatform.system}
      or (throw "opencode-desktop has no build for ${stdenv.hostPlatform.system}")
  );

  # Extract the AppImage a second time (wrapType2's own extraction is the same
  # derivation) so extraInstallCommands can install the desktop entry and the
  # icons the bundle ships.
  appimageContents = appimageTools.extract {
    inherit pname version src;
  };
in
appimageTools.wrapType2 {
  inherit pname version src;

  extraInstallCommands = ''
    # Upstream's own desktop file runs the app as `AppRun --no-sandbox %U`;
    # keep that flag. The bundle's chrome-sandbox cannot be setuid inside the
    # store, and the SUID-helper check aborts on hosts that restrict
    # unprivileged user namespaces.
    #
    # wrapType2 exposes only bin/${pname} (a symlink into the FHS env carrying
    # the libraries the bundle expects), and the flag has to reach the CLI
    # entry point too, not just menu launches — so re-point that symlink at a
    # one-line launcher.
    target="$(readlink $out/bin/${pname})"
    if [ ! -x "$target" ]; then
      echo "${pname}: expected $out/bin/${pname} to be appimageTools.wrapType2's symlink to the wrapped FHS env, got '$target'" >&2
      exit 1
    fi
    rm $out/bin/${pname}
    cat > $out/bin/${pname} <<EOF
    #!${runtimeShell}
    exec "$target" --no-sandbox "\$@"
    EOF
    chmod 755 $out/bin/${pname}

    # Upstream's file is ai.opencode.desktop.desktop — keep that id, it is the
    # StartupWMClass and the name in x-scheme-handler/opencode registrations.
    install -Dm444 ${appimageContents}/ai.opencode.desktop.desktop \
      $out/share/applications/ai.opencode.desktop.desktop
    substituteInPlace $out/share/applications/ai.opencode.desktop.desktop \
      --replace-fail 'Exec=AppRun --no-sandbox %U' 'Exec=${pname} --no-sandbox %U'

    # The bundle also carries ai.storyteller.photocraft.* entries for an
    # unrelated app from upstream's packaging template; do not install those.
    for size in 32 64 128; do
      install -Dm444 ${appimageContents}/usr/share/icons/hicolor/''${size}x''${size}/apps/ai.opencode.desktop.png \
        $out/share/icons/hicolor/''${size}x''${size}/apps/ai.opencode.desktop.png
    done
  '';

  # ./update.py regenerates the version/hash pin above from upstream's release
  # API; this makes `nix-update opencode-desktop --flake --use-update-script`
  # use it.
  passthru.updateScript = ./update.py;

  meta = with lib; {
    description = "OpenCode Desktop: graphical client for the OpenCode AI coding agent";
    homepage = "https://opencode.ai";
    license = licenses.mit;
    mainProgram = pname;
    platforms = [
      "x86_64-linux"
      "aarch64-linux"
    ];
    sourceProvenance = with sourceTypes; [ binaryNativeCode ];
  };
}
