# oh-my-mermaid (omm) — architecture-mirror CLI + coding-agent skills
# (https://github.com/oh-my-mermaid/oh-my-mermaid). `omm write`/`omm view`
# manage a `.omm/` tree of Mermaid diagrams per project; the bundled skills
# (omm-scan, omm-push, omm-view) are symlinked into ~/.config/opencode/skills
# by users/opencode.nix, where opencode picks them up natively.
#
# Not in nixpkgs and only published on npm, so build the registry tarball of
# `oh-my-mermaid`. The published tarball already ships the compiled `dist/`
# (`prepublishOnly` runs the build at publish time), so `dontNpmBuild` skips
# the build and only the runtime dependencies are installed. A generated
# package-lock.json (npm install --package-lock-only) is committed so
# `buildNpmPackage` can resolve the dependency tree offline, the same pattern
# as packages/rea and packages/deepseek-harness. The bundled `skills/` are
# copied to $out/share/oh-my-mermaid/skills for declarative installation.
{ lib
, fetchurl
, buildNpmPackage
, nodejs
}:

buildNpmPackage {
  pname = "oh-my-mermaid";
  version = "0.2.0";

  src = fetchurl {
    url = "https://registry.npmjs.org/oh-my-mermaid/-/oh-my-mermaid-0.2.0.tgz";
    hash = "sha256-SUvckksUDA4GnGMp6kmNm3ONy6iDZO4ot5HqSecRfc0=";
  };

  postPatch = ''
    cp ${./package-lock.json} package-lock.json
  '';

  npmDepsHash = "sha256-Vn5HYcfjEOBJZ0uz/42U45xzD/+0yIFpLW+AOPE3mqk=";

  dontNpmBuild = true;

  postInstall = ''
    mkdir -p $out/share/oh-my-mermaid
    cp -r skills $out/share/oh-my-mermaid
    # Patch opencode-specific metadata into each SKILL.md frontmatter (before
    # the closing --- delimiter): expose the skills as /omm-scan etc. in the
    # TUI and keep them out of the model's auto-selection, so they only ever
    # run when invoked explicitly in a project.
    for skill in $out/share/oh-my-mermaid/skills/*/SKILL.md; do
      awk '/^---$/{n++; if(n==2){print "metadata:"; print "  opencode/slash: \"true\""; print "  opencode/autoinvoke: \"false\""; print; next}} {print}' \
        "$skill" > "$skill.tmp"
      mv "$skill.tmp" "$skill"
    done
  '';

  meta = with lib; {
    description = "Turn codebases into navigable Mermaid architecture diagrams, generated by coding agents";
    homepage = "https://github.com/oh-my-mermaid/oh-my-mermaid";
    license = licenses.mit;
    mainProgram = "omm";
    platforms = nodejs.meta.platforms;
  };
}
