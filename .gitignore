.history/
tmp/
result
result-*
.agentmem/
# JetBrains IDE project state (kept locally, not in git).
.idea/
# Tinymist (Typst LSP) compilation cache: auto-generated, indexes absolute
# store paths under result/, machine-specific.
tinymist.lock

# Vendor driver archive (kept locally; not needed in git, ~18 MB).
displaylink-*.zip

# Plaintext secrets. The committed forms are the agenix-encrypted .age files.
secrets/cifs/
secrets/nicky.nix
secrets/open-webui.env
secrets/syncthing-gui-password

# Private SSH keys used as agenix recipients. These must be backed up in
# KeePassXC and distributed to each host/user. NEVER commit these (see
# secrets-structure/README.md).
ssh-keys/**
# Backup archive of the private keys (same secret content), now passphrase-encrypted.
ssh-keys-backup-*.tar.gz*
# Imported syncthing config dumps from physical hosts (plaintext cert/key).
laptop-*-dotconfig-syncthing/
laptop-*-dotconfig-syncthing.zip
