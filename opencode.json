      ]
    },
    "ivp-refactor-auditor": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
      "system": "{file:../llm-harness-plugins/ivp/agents/ivp-refactor-auditor.md}",
      "variants": [
        {
          "id": "default",
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      ]
    }
