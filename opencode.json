{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "../llm-harness-plugins/guardrail-chain/opencode",
    "../llm-harness-plugins/session-lifecycle/opencode",
    "../llm-harness-plugins/agentmem/opencode",
    "../llm-harness-plugins/datetime-inject/opencode",
    "../llm-harness-plugins/offpeak-nudge/opencode",
    "../llm-harness-plugins/tier-router/opencode",
    "../llm-harness-plugins/agentinsights/opencode",
    "../llm-harness-plugins/ivp/opencode",
    "../llm-harness-plugins/codify-first/opencode",
    "../llm-harness-plugins/systemone/opencode",
    "../llm-harness-plugins/general-skills/opencode"
  ],
  "agents": {
    "driver-identifier": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
      "system": "{file:../llm-harness-plugins/ivp/agents/driver-identifier.md}",
      "variants": [
        {
          "id": "default",
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      ]
    },
    "driver-assignment-auditor": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
      "system": "{file:../llm-harness-plugins/ivp/agents/driver-assignment-auditor.md}",
      "variants": [
        {
          "id": "default",
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      ]
    },
    "gamma-modularizer": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
      "system": "{file:../llm-harness-plugins/ivp/agents/gamma-modularizer.md}",
      "variants": [
        {
          "id": "default",
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      ]
    },
    "nest-decider": {
      "model": "deepseek/deepseek-v4-pro",
      "mode": "subagent",
      "system": "{file:../llm-harness-plugins/ivp/agents/nest-decider.md}",
      "variants": [
        {
          "id": "default",
          "body": {
            "thinking": {
              "type": "enabled"
            }
