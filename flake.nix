{
  description = "NixOS configuration";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-26.05";
    # Fast-moving AI tooling (opencode, opencode-desktop, pi-coding-agent,
    # herdr, jetbrains-toolbox, vscode) for nicky/aeiuno is overlaid from
    # unstable on top of the stable base; see overlays/ai-unstable.nix.
    nixpkgs-unstable.url = "github:nixos/nixpkgs/nixos-unstable";
    home-manager.url = "github:nix-community/home-manager/release-26.05";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
    nixos-hardware.url = "github:NixOS/nixos-hardware/master";
    # agenix: age-encrypted secrets managed in git. Encrypted .age files are
    # committed; private keys stay in the gitignored age-keys/ and on each host.
    agenix.url = "github:ryantm/agenix";
    # Snapshot testing for the generated config fragments (namaka.lib.load).
    # Pinned tag; nix-unit/namaka binaries come from nixpkgs.
    namaka.url = "github:nix-community/namaka/v0.2.1";
    namaka.inputs.nixpkgs.follows = "nixpkgs";
    namaka.inputs.haumea.inputs.nixpkgs.follows = "nixpkgs";
    # Strata (github.com/Niko1221/Strata) is not a flake input: packages/strata
    # fetches it directly with fetchFromGitHub, pinned to v0.2.2 (engine 0.1.47;
    # the app and the engine are versioned separately since 0.2.0) in
    # engine.nix/default.nix. (It used to be the private yannickloth/forks-Strata
    # fork's sm_86 branch; upstream 0.1.40.3 now carries every engine change the
    # fork had, so the fork only added a bench harness - see git history.)
    # hermes-agent packaging (packages/hermes-agent): builds the upstream
    # uv.lock into a Python virtualenv. Pin all three to this repo's
    # nixpkgs-unstable so there is a single evaluation of nixpkgs.
    pyproject-nix.url = "github:nix-community/pyproject.nix";
    pyproject-nix.inputs.nixpkgs.follows = "nixpkgs-unstable";
    pyproject-build-systems.url = "github:pyproject-nix/build-system-pkgs";
    pyproject-build-systems.inputs.pyproject-nix.follows = "pyproject-nix";
    pyproject-build-systems.inputs.uv2nix.follows = "uv2nix";
    pyproject-build-systems.inputs.nixpkgs.follows = "nixpkgs-unstable";
    uv2nix.url = "github:pyproject-nix/uv2nix";
    uv2nix.inputs.pyproject-nix.follows = "pyproject-nix";
    uv2nix.inputs.nixpkgs.follows = "nixpkgs-unstable";
  };

  outputs = { self, nixpkgs, nixpkgs-unstable, home-manager, nixos-hardware, agenix, namaka, uv2nix, pyproject-nix, pyproject-build-systems, ... }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs {
        inherit system;
        config.allowUnfree = true;
      };
      # Stable pkgs (nixpkgs) are the base for every user; only the AI tooling
      # list in overlays/ai-unstable.nix is swapped to unstable builds, and only
      # for the adults (nicky, aeiuno). sven/aaron stay on plain stable.
      unstablePkgs = import nixpkgs-unstable {
        inherit system;
        config.allowUnfree = true;
      };
      # Hermes Agent (Nous Research) built from upstream uv.lock via uv2nix.
      hermesAgent = unstablePkgs.callPackage ./packages/hermes-agent {
        uv2nix = uv2nix;
        pyproject-nix = pyproject-nix;
        pyproject-build-systems = pyproject-build-systems;
      };
      browseros = pkgs.callPackage ./packages/browseros { };
      aiOverlay = import ./overlays/ai-unstable.nix {
        inherit unstablePkgs;
        inherit hermesAgent browseros;
      };
    in
    {
      devShells.${system}.default = pkgs.mkShell {
        packages = with pkgs; [
          nixpkgs-fmt # legacy formatter; nixfmt (RFC style) is the target (see plan)
          nixfmt # RFC-style formatter: `nix fmt`
          deadnix # dead-code detection for Nix
          statix # Nix lint/anti-pattern checks
          nil
          nix-output-monitor
          nvd
          rage
          git
          jq
          ripgrep
          fd
          bat
          eza
          direnv
          shellcheck
          # Secrets management (agenix CLI + age for encrypting/decrypting).
          agenix.packages.${system}.default
          age
        ];
      };

      # `nix fmt` target (RFC-style). Bulk reformat is deferred until the
      # Phase 0/2 cleanups land, so CI does not enforce formatting yet.
      formatter.${system} = pkgs.nixfmt;

      checks.${system} =
        let
          lib' = pkgs.lib;

          # Shell scripts generated by our modules. CI never executes them, so
          # this check proves they at least parse, and shellcheck's error-level
          # findings are real bugs.
          scriptFiles = {
            ssh-user-keys = pkgs.writeText "ssh-user-keys.sh"
              self.nixosConfigurations.laptop-xps.config.systemd.services.ssh-user-keys.script;
            home-readmes = pkgs.writeText "home-readmes.sh"
              self.nixosConfigurations.laptop-xps.config.systemd.services.home-readmes.script;
            syncthing-acl = pkgs.writeText "syncthing-acl.sh"
              self.nixosConfigurations.laptop-xps.config.system.activationScripts."syncthing-acl".text;
            btrfs-user-quotas = pkgs.writeText "btrfs-user-quotas.sh"
              self.nixosConfigurations.laptop-xps.config.system.activationScripts."btrfs-user-quotas".text;
            hera-syncthing-data = pkgs.writeText "hera-syncthing-data.sh"
              self.nixosConfigurations.laptop-hera.config.systemd.services.syncthing-hera-data-dir.script;
            usb-scan = pkgs.writeText "usb-scan.sh" (builtins.readFile ./services/usb-scan.sh);
            natural-scroll = pkgs.writeText "natural-scroll.sh"
              self.nixosConfigurations.laptop-xps.config.home-manager.users.nicky.home.activation.setNaturalScroll.data;
            unsloth-free-gpu = pkgs.writeText "unsloth-free-gpu.sh"
              self.nixosConfigurations.laptop-p16.config.home-manager.users.nicky.home.file.".local/bin/unsloth-studio-free-gpu.sh".text;
            unsloth-unload = pkgs.writeText "unsloth-unload.sh"
              self.nixosConfigurations.laptop-p16.config.home-manager.users.nicky.home.file.".local/bin/unsloth-studio-unload.sh".text;
            llama-handoff = pkgs.writeText "llama-handoff.sh"
              self.nixosConfigurations.laptop-p16.config.home-manager.users.nicky.home.file.".unsloth/llama.cpp/build/bin/llama-server-handoff".text;
          };

          # Scripts that are already derivations (built by writeShellScript).
          scriptPaths = [
            (builtins.head self.nixosConfigurations.laptop-xps.config.home-manager.users.sven.systemd.user.services.flatpak-install.Service.ExecStart)
          ];

          # The runtime tree of the strata package (its share/strata). The check
          # below drives the REAL strata_control/user_args.py through this, so an
          # upstream API change is caught here instead of in someone's runtime
          # directory. It is the runtime derivation only: no CUDA engine.
          strataShare = (pkgs.callPackage ./packages/strata { }).passthru.runtimeShare;

          # Only our kid-game profiles: the nixpkgs lxc profiles include
          # <tunables/global>, which is not in the build sandbox.
          apparmorProfiles = lib'.mapAttrs
            (name: policy: pkgs.writeText "${name}.profile" policy.profile)
            (lib'.filterAttrs (name: _: lib'.hasPrefix "kid-" name)
              self.nixosConfigurations.laptop-xps.config.security.apparmor.policies);
        in
        {
          parse-all = pkgs.runCommandLocal "parse-all" { nativeBuildInputs = [ pkgs.nix ]; } ''
            set -euo pipefail
            # The sandbox cannot write /nix/var/nix; give Nix a private state dir.
            export HOME=$TMPDIR
            export NIX_STATE_DIR=$TMPDIR/nix
            export NIX_LOG_DIR=$TMPDIR/nix/log
            export NIX_CONF_DIR=$TMPDIR/etc
            mkdir -p "$NIX_STATE_DIR" "$NIX_LOG_DIR" "$NIX_CONF_DIR"
            cd ${self}
            while IFS= read -r -d "" f; do
              nix-instantiate --parse "$f" >/dev/null
            done < <(find . -name '*.nix' -not -path './.git/*' -print0)
            touch $out
          '';

          hosts-eval = pkgs.runCommandLocal "hosts-eval" { } ''
            cat > $out <<'EOF'
            ${builtins.unsafeDiscardStringContext self.nixosConfigurations.laptop-xps.config.system.build.toplevel.drvPath}
            ${builtins.unsafeDiscardStringContext self.nixosConfigurations.laptop-hera.config.system.build.toplevel.drvPath}
            ${builtins.unsafeDiscardStringContext self.nixosConfigurations.laptop-p16.config.system.build.toplevel.drvPath}
            EOF
          '';

          unit = pkgs.runCommandLocal "nix-unit" { nativeBuildInputs = [ pkgs.nix-unit ]; } ''
            export HOME=$TMPDIR
            export NIX_STATE_DIR=$TMPDIR/nix
            export NIX_LOG_DIR=$TMPDIR/nix/log
            export NIX_CONF_DIR=$TMPDIR/etc
            mkdir -p "$NIX_STATE_DIR" "$NIX_LOG_DIR" "$NIX_CONF_DIR"
            cd ${self}
            nix-unit --gc-roots-dir "$TMPDIR/gcroots" tests/unit.nix > $out
          '';

          snapshots = pkgs.runCommandLocal "namaka-snapshots" { } ''
            test '${builtins.toJSON (namaka.lib.load { src = ./tests/snapshots; inputs = { flake = self; }; })}' = '{}'
            touch $out
          '';

          scripts-syntax = pkgs.runCommandLocal "scripts-syntax" {
            nativeBuildInputs = [ pkgs.bash pkgs.shellcheck ];
          } ''
            set -euo pipefail
            ${lib'.concatMapStringsSep "\n" (f: ''
              bash -n ${f}
              shellcheck -s bash -S error -e SC1091,SC2148 ${f}
            '') (lib'.attrValues scriptFiles ++ scriptPaths)}
            touch $out
          '';

          apparmor-parse = pkgs.runCommandLocal "apparmor-parse" {
            nativeBuildInputs = [ pkgs.apparmor-parser ];
          } ''
            set -euo pipefail
            ${lib'.concatMapStringsSep "\n" (f: "apparmor_parser -Q ${f}") (lib'.attrValues apparmorProfiles)}
            touch $out
          '';

          python-compile = pkgs.runCommandLocal "python-compile" { nativeBuildInputs = [ pkgs.python3 ]; } ''
            python3 -c 'compile(open("${./packages/strata/config_patch.py}").read(), "config_patch.py", "exec")'
            touch $out
          '';

          strata-fail-closed = pkgs.runCommandLocal "strata-fail-closed" {
            nativeBuildInputs = [ pkgs.python3 pkgs.coreutils ];
          } ''
            export STRATA_HOME=$TMPDIR/strata
            mkdir -p "$STRATA_HOME"

            # 1. a config with no "user_args" layer yet: the module policy lands
            #    in "args".
            printf '{"args":["--max-context","4096"]}' > "$STRATA_HOME/strata-good.json"
            python3 ${./packages/strata/config_patch.py} 8192 kv8 0 none 1800 none none none none none false '{}' false ${strataShare}
            grep -q -- '--expert-cache' "$STRATA_HOME/strata-good.json"
            grep -q -- '"--spec-min-p"' "$STRATA_HOME/strata-good.json"
            grep -q -- '"2"' "$STRATA_HOME/strata-good.json"
            grep -q -- '"8192"' "$STRATA_HOME/strata-good.json"
            if grep -q -- '--prompt-cache-tail' "$STRATA_HOME/strata-good.json"; then
              echo "tail flag added despite false" >&2; exit 1
            fi

            # 2. an unchanged rerun must leave the file alone: strata-server picks
            #    the served model by mtime, so rewriting reorders what is served.
            #    This is what catches set_opt moving flags to the end.
            m1=$(stat -c %Y "$STRATA_HOME/strata-good.json")
            sleep 1
            python3 ${./packages/strata/config_patch.py} 8192 kv8 0 none 1800 none none none none none false '{}' false ${strataShare}
            m2=$(stat -c %Y "$STRATA_HOME/strata-good.json")
            [ "$m1" = "$m2" ] || { echo "config rewritten on an unchanged rerun" >&2; exit 1; }

            # 3. since 0.2.0 a config also carries "user_args", which
            #    serve/server.py merges OVER "args" at every start: a stale value
            #    there would beat the module options, so the policy flags are
            #    taken out of it while the person's own options stay.
            printf '{"args":["--max-context","8192","--expert-cache","auto","--spec","4"],"args_written":["--max-context","8192","--expert-cache","auto","--spec","4"],"user_args":["--max-context","4096","--vram-reserve-mib","0","--control-vector","/cv.gguf"]}' > "$STRATA_HOME/strata-ua.json"
            python3 ${./packages/strata/config_patch.py} 8192 kv8 0 none 1800 none none none none none false '{}' false ${strataShare}
            python3 -c '
            import json, sys
            cfg = json.load(open(sys.argv[1]))
            ua = cfg.get("user_args") or []
            assert "--max-context" not in ua, ua
            assert "--vram-reserve-mib" not in ua, ua
            assert "--control-vector" in ua, ua
            a = cfg["args"]
            assert a[a.index("--max-context") + 1] == "8192", a
            ' "$STRATA_HOME/strata-ua.json"

            # 4. the upgrade case: a config written before 0.2.0 has no
            #    "args_written" and may hold engine options setup.py does not know
            #    (the calibrated ones are the module's, but -adapt-swaps /
            #    -adapt-decay are the person's). The policy must be applied and
            #    those hand edits must survive, and no "args_written" may be
            #    invented for them or the next `strata --setup` drops them.
            printf '{"args":["--expert-cache","auto","--spec","4","--max-context","65536","--adapt-swaps","160","--adapt-decay","0.97"]}' > "$STRATA_HOME/strata-old.json"
            python3 ${./packages/strata/config_patch.py} 8192 kv8 0 none 1800 none none none none none false '{}' false ${strataShare}
            grep -q -- '--adapt-swaps' "$STRATA_HOME/strata-old.json"
            grep -q -- '--adapt-decay' "$STRATA_HOME/strata-old.json"
            grep -q -- '"8192"' "$STRATA_HOME/strata-old.json"
            if grep -q -- 'args_written' "$STRATA_HOME/strata-old.json"; then
              echo "args_written invented for a pre-0.2.0 config" >&2; exit 1
            fi

            # 5. last, because this file makes EVERY later run fail: an
            #    unreadable config is a hard failure, since this script is the
            #    enforcement point of the policy and must not fail open with
            #    stale settings.
            printf 'not json' > "$STRATA_HOME/strata-bad.json"
            if python3 ${./packages/strata/config_patch.py} 8192 kv8 0 none 1800 none none none none none false '{}' false ${strataShare}; then
              echo "invalid config did not fail" >&2; exit 1
            fi
            touch $out
          '';
        };


      # System 1 decision engines. Scope wrappers live beside them:
      # packages/laya/{home,nixos}.nix and packages/clm/home.nix.
      #
      # Everything lives in ONE packages.${system} attrset: flake outputs do not
      # merge repeated dynamic-attribute paths. The ArtCraft "Crafting Apps"
      # (packages/craft-apps) already come as an attrset, so they are spread in
      # alongside the individually listed packages.
      packages.${system} =
        # import (not callPackage): callPackage wraps the returned attrset with
        # lib.makeOverridable, which would add `override`/`overrideDerivation`
        # function attrs into the package set (and, in users/common-hm.nix,
        # leak into home.packages via builtins.attrValues).
        #
        # Left at the default cachyos = false: these generic attributes are the
        # plain wrapper for `nix build` / `nix-update`. The CachyOS laptop-p16
        # deployment opts into the bundled GPU/audio stack via the host-aware
        # install in users/common-hm.nix.
        (import ./packages/craft-apps {
          inherit (pkgs) lib appimageTools fetchurl;
        })
        // {
          laya = pkgs.callPackage ./packages/laya { };
          clm = pkgs.callPackage ./packages/clm { };
          # Strata (packages/strata): CUDA inference engine for the A3000
          # (sm_86) + runtime wrappers; consumed via home-manager
          # (packages/strata/home.nix, `strata.enable`). Built WITHOUT the
          # strata-vision image encoder: image support drops throughput from
          # ~35 to ~22 tok/s, so vision stays off.
          strata = pkgs.callPackage ./packages/strata { vision = false; };
          # Orca (packages/orca): the released Electron AppImage wrapped as a
          # normal derivation (appimageTools.wrapType2). Consumed via home-manager
          # (packages/orca/home.nix) and also exposed here for `nix build .#orca`
          # / `nix-update`.
          orca = pkgs.callPackage ./packages/orca { };
          # BrowserOS neo (packages/browseros): agent-driven browser for AI
          # assistants, packaged from the upstream AppImage.
          browseros = pkgs.callPackage ./packages/browseros { };
          # opencode CLI + Desktop are in-tree pins (nixpkgs ships the 1.x
          # line, upstream's v2 is npm/AppImage only) and carry an
          # `updateScript`, so `nix-update opencode --flake --use-update-script`
          # (likewise `opencode-desktop`) bumps their version and hashes.
          opencode = unstablePkgs.callPackage ./packages/opencode2 { };
          opencode-desktop = unstablePkgs.callPackage ./packages/opencode-desktop { };
          # REA (packages/rea): npm-only MCP+CLI reverse-engineering toolkit,
          # built from the registry tarball on unstable's Node (matches the
          # overlay, so the installed users share this store path).
          rea = unstablePkgs.callPackage ./packages/rea { };
        };

      nixosConfigurations =
        let
          # Default kernel: nixpkgs zen (BORE-ish interactive tuning); Hydra
          # builds it, so `nix flake update` is a download. The CachyOS LTO
          # kernels were dropped: their cache lagged each pin and could trigger
          # a multi-hour local LTO build. See git history to reintroduce.
          #
          # NVIDIA caveat: linux_zen is on 7.2, whose DRM atomic-state rename
          # (`drm_atomic_state` -> `drm_atomic_commit`) and strncpy removal are
          # only handled by NVIDIA >= 595.99.02 (nixpkgs-unstable). Stable's
          # 595.71.05 does not compile against 7.2, so the NVIDIA hosts (hera,
          # p16) pin the desktop-tuned XanMod 6.18 LTS instead (see mkHost).
          #
          # Home-manager + shared-module wiring common to every host.
          commonModules = [
            home-manager.nixosModules.home-manager
            agenix.nixosModules.default
            # Give nicky/aeiuno the AI-unstable pkgs overlay (opencode,
            # opencode-desktop, pi, herdr, jetbrains-toolbox, vscode,
            # hermes-agent, magpie, deepseek-harness); sven/aaron keep plain
            # stable pkgs.
            ./users/ai-pkgs.nix
            # Inject the agenix home-manager module so home-manager users can
            # use `age.secrets` (nicky and aeiuno do, for the opencode provider
            # keys on standalone/CachyOS home-manager).
            { home-manager.users.nicky.imports = [ agenix.homeManagerModules.default ]; }
            { home-manager.users.aeiuno.imports = [ agenix.homeManagerModules.default ]; }
            {
              home-manager.useGlobalPkgs = true;
              home-manager.useUserPackages = true;
              # Take over pre-existing unmanaged files (e.g. a plain ~/.zshrc
              # from zsh-newuser-install) instead of failing activation.
              home-manager.backupFileExtension = "backup";
            }
          ];

          # One host: its configuration module + any host-only modules, on top
          # of commonModules. `kernelPackages` defaults to the nixpkgs zen
          # kernel; the NVIDIA hosts override it to XanMod 6.18 LTS because the
          # stable NVIDIA driver cannot build against zen's 7.2 (see above).
          mkHost =
            {
              configModule,
              extraModules ? [ ],
              kernelPackages ? pkgs.linuxKernel.packages.linux_zen,
            }:
            nixpkgs.lib.nixosSystem {
              system = "x86_64-linux";
              specialArgs = { inherit aiOverlay; };
              modules = [ configModule ] ++ extraModules ++ commonModules ++ [
                { boot.kernelPackages = kernelPackages; }
              ];
            };
        in
        {
          # GTX 1050 Ti (proprietary modules).
          laptop-hera = mkHost {
            configModule = ./hosts/laptop-hera/laptop-hera-configuration.nix;
            kernelPackages = pkgs.linuxKernel.packages.linux_xanmod;
          };

          # generic ThinkPad base; a model-specific module (e.g. thinkpad/p16s)
          # may be added once confirmed via dmidecode.
          # RTX A3000 (open modules).
          laptop-p16 = mkHost {
            configModule = ./hosts/laptop-p16/laptop-p16-configuration.nix;
            extraModules = [ nixos-hardware.nixosModules.lenovo-thinkpad ];
            kernelPackages = pkgs.linuxKernel.packages.linux_xanmod;
          };

          laptop-xps = mkHost {
            configModule = ./hosts/laptop-xps/laptop-xps-configuration.nix;
            extraModules = [ nixos-hardware.nixosModules.dell-xps-13-9360 ];
          };
        };
    };
}
